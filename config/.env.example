# =============================================================================
# Environment variable template — Thoughts Dashboard
# Copy to .env for local development:  cp config/.env.example .env
#
# NEVER commit .env to source control — it is in .gitignore
# In OpenShift/Kubernetes: inject these via Kubernetes Secrets
# =============================================================================

# -- Database connection (REQUIRED) --
DB_HOST=postgresql.thoughts-app.svc.cluster.local
DB_NAME=thoughts
DB_USER=thoughts
DB_PASSWORD=<set-from-kubernetes-secret>

# -- Optional database settings --
DB_PORT=5432
DB_POOL_MIN=1
DB_POOL_MAX=10
DB_TIMEOUT=30

# -- Flask (REQUIRED) --
# Generate a strong secret key:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=<generate-a-strong-random-value>

# -- Flask environment --
FLASK_DEBUG=false
